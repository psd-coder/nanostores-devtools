{
  "name": "nanostores-devtools",
  "version": "0.1.0",
  "description": "Devtools for nanostores",
  "keywords": [
    "nanostores",
    "devtools",
    "debug",
    "store",
    "state"
  ],
  "license": "MIT",
  "author": "Pavel Grinchenko <psd-coder@evilmartians.com>",
  "repository": "psd-coder/nanostores-devtools",
  "bugs": "https://github.com/psd-coder/nanostores-devtools/issues",
  "homepage": "https://github.com/psd-coder/nanostores-devtools#readme",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "production": "./dist/noop.mjs",
      "default": "./dist/index.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "default": "./dist/runtime.mjs"
    },
    "./vite": {
      "types": "./dist/discovery/vite.d.mts",
      "default": "./dist/discovery/vite.mjs"
    },
    "./webpack": {
      "types": "./dist/discovery/webpack.d.mts",
      "default": "./dist/discovery/webpack.mjs"
    },
    "./rspack": {
      "types": "./dist/discovery/rspack.d.mts",
      "default": "./dist/discovery/rspack.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm run --parallel /^lint:/",
    "lint:oxlint": "oxlint",
    "lint:oxfmt": "oxfmt --check . '!**/package.json'",
    "format": "oxfmt --write . '!**/package.json'",
    "publint": "publint --strict",
    "attw": "pnpm pack --out node_modules/.attw.tgz --config.ignore-scripts=true && attw node_modules/.attw.tgz --profile esm-only",
    "size": "size-limit",
    "bump": "./scripts/bump.sh",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged",
    "pre-push": "pnpm typecheck"
  },
  "nano-staged": {
    "*.{js,cjs,mjs,jsx,ts,mts,cts,tsx}": [
      "oxlint --fix --fix-suggestions",
      "oxfmt"
    ]
  },
  "peerDependencies": {
    "nanostores": "^1.0.0",
    "oxc-parser": ">=0.143.0 <1",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "oxc-parser": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@jridgewell/sourcemap-codec": "^1.5.5",
    "@nanostores/router": "1.1.0",
    "@rspack/core": "^2.1.10",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/node": "^24.13.3",
    "jsan": "3.1.14",
    "nano-staged": "^1.0.2",
    "nanostores": "1.5.2",
    "oxc-parser": "0.146.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "publint": "^0.3.23",
    "simple-git-hooks": "^2.13.1",
    "size-limit": "^13.0.3",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "8.2.1",
    "vitest": "^4.1.10",
    "webpack": "^5.109.2"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "dependencies": {
    "magic-string": "^1.1.0",
    "unplugin": "^3.3.0"
  },
  "size-limit": [
    {
      "name": "browser entry",
      "path": "dist/index.mjs",
      "limit": "11 kB"
    }
  ]
}
